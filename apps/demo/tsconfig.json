{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".next/tsc",
    "tsBuildInfoFile": ".next/tsc/.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "next.config.ts"],
  "exclude": ["node_modules", "out", ".next"],
  "references": [{ "path": "../../packages/shared" }, { "path": "../../packages/react" }]
}
