# ---------------------------------------------------------------------------
# Live Class server configuration. Copy to `.env` for local development.
# Every variable is validated at startup (packages/server/src/config.ts); the
# process refuses to start with a clear message if something is missing.
# Never commit a real `.env`.
# ---------------------------------------------------------------------------

# HTTP + WebSocket port. Hosting platforms usually inject this.
PORT=4000

# Comma-separated list of browser origins allowed to call the API (the host app
# and the demo). Use the exact scheme + host + port.
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Postgres connection string (Supabase/Neon/any Postgres), e.g.
#   postgres://user:password@host:5432/postgres?sslmode=require
# For development and tests without any install, use the embedded Postgres:
#   pglite://./.data/dev
DATABASE_URL=pglite://./.data/dev
# Run pending migrations when the server starts (true for simple deployments).
DB_MIGRATE_ON_START=true

# --- File storage ----------------------------------------------------------
# `local` writes under STORAGE_LOCAL_DIR (dev only: wiped on most free hosts).
# `s3` works with any S3-compatible service: Supabase Storage, Cloudflare R2,
# AWS S3, MinIO. Switching providers is only a change of these values.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/uploads
# S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_BUCKET=live-class
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Authentication --------------------------------------------------------
# Tokens minted by the host application. Provide ONE of JWKS URL or shared secret.
# AUTH_HOST_JWKS_URL=https://host.example.com/.well-known/jwks.json
# AUTH_HOST_SHARED_SECRET=change-me-to-a-long-random-string
AUTH_HOST_ISSUER=live-class-host
AUTH_HOST_AUDIENCE=live-class

# Local email/password login for development and demos only. Keep false in production.
AUTH_LOCAL_ENABLED=true
AUTH_LOCAL_JWT_SECRET=dev-only-secret-change-me-please-32chars
# Seed users created on first start when local auth is enabled (password for all).
AUTH_LOCAL_SEED_PASSWORD=password123

# --- Realtime --------------------------------------------------------------
# Optional: set to fan out realtime updates across several server instances.
# REDIS_URL=redis://localhost:6379

# --- Limits and logging ----------------------------------------------------
MAX_UPLOAD_MB=25
# Login attempts per minute per client (keep low; raised only in automated tests).
RATE_LIMIT_LOGIN_PER_MINUTE=10
LOG_LEVEL=info
# Pretty-print logs in development (false emits JSON lines for log collectors).
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# Demo app (apps/demo). Public values baked into the static build.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LIVE_CLASS_API=http://localhost:4000
NEXT_PUBLIC_LIVE_CLASS_WS=ws://localhost:4000/realtime
