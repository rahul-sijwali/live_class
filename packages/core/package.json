{
  "name": "@live-class/core",
  "version": "0.1.0",
  "description": "Framework-free engine for Live Class sheets: geometry, ink, realtime sync, question rendering and the typed API client.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/test/fake-realtime.d.ts",
      "import": "./dist/test/fake-realtime.js",
      "default": "./dist/test/fake-realtime.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "@live-class/shared": "workspace:*",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.16",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0"
  }
}
